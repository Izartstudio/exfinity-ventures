NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
SANITY_STUDIO_PROJECT_ID=${NEXT_PUBLIC_SANITY_PROJECT_ID}
SANITY_STUDIO_DATASET=${NEXT_PUBLIC_SANITY_DATASET}

# Server-only Google Apps Script web-app integration. Never prefix these with
# NEXT_PUBLIC_, because the webhook secret must not be sent to browsers.
WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
WEBHOOK_SECRET=replace-with-a-long-random-secret
